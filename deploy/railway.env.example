# Configuration template for deploying to Railway (railway.com).
#
# This file is documentation only — Railway never reads it. Set these as
# service Variables in the Railway dashboard (or `railway variables --set`).
#
# Shape of the deployment (see railway.json at the repo root):
#   * ONE image, built from deploy/Dockerfile (the default CMD runs the
#     scoring API; the dashboard overrides APP_MODULE below).
#   * TWO services created from that image, named exactly `api` and
#     `dashboard`, so the dashboard's FRAUD_API_BASE_URL resolves over
#     Railway private networking as <service-name>.railway.internal.
#
# Both services fail closed (503/401) while a required credential is empty or
# still a "<placeholder>", so a half-configured deploy cannot run open.
#
# Generate strong secrets locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------------------
# api service (scoring API; default image entrypoint)
# ---------------------------------------------------------------------------

# Railway injects PORT at runtime, but pin it as an explicit variable so the
# private hostname and the public domain's target port are deterministic.
PORT=8000

# Service credential presented as X-API-Key by the dashboard BFF (and any
# other trusted caller). The dashboard service must carry the SAME value.
DEMO_API_TOKEN=<generate-a-random-32-byte-secret>

# mock = labeled synthetic fixtures, zero provider cost (default).
QWEN_MODE=mock
# For QWEN_MODE=live also set DASHSCOPE_API_KEY, QWEN_BASE_URL, QWEN_MODEL
# (see deploy/.env.example for the region rules).

# ---------------------------------------------------------------------------
# dashboard service (analyst console; same image, different entrypoint)
# ---------------------------------------------------------------------------

# Runs the BFF instead of the scoring API: the start command in railway.json
# reads APP_MODULE (default fraud_demo:app).
APP_MODULE=dashboard:app

PORT=8001

# Scoring API as reached over Railway's private network (service named `api`).
# Plain http:// is correct here: the private network is Wireguard-encrypted.
FRAUD_API_BASE_URL=http://api.railway.internal:8000

# Required opt-in: the BFF rejects plaintext non-loopback base URLs by
# default. Safe to set on Railway; see app/dashboard.py for the rationale.
FRAUD_API_ALLOW_PRIVATE_HTTP=1

# Same value as the api service (the BFF signs upstream calls with it).
DEMO_API_TOKEN=<same value as the api service>

# Browser sign-in credential for the console (distinct from DEMO_API_TOKEN).
DASHBOARD_TOKEN=<generate-a-different-random-secret>

# The dashboard will be served over HTTPS by Railway's edge, so the session
# cookie must be marked Secure.
DASHBOARD_SECURE_COOKIES=1
