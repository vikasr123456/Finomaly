# Configuration template. Copy to `.env` and fill in real values.
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# NEVER commit the filled-in file, and never paste credentials into chat, an
# issue tracker, or a slide. Every value below starting with "<" is a
# placeholder: both services fail closed (503/401) while a placeholder or empty
# value is present, so a mis-deploy cannot silently run unauthenticated.
#
# Generate strong secrets locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------------------
# REQUIRED SECRETS (store in your platform secret manager, not in git)
# ---------------------------------------------------------------------------

# Service credential presented as `X-API-Key` on every scoring-API request:
# POST /transactions, POST /transactions/{id}/assess, and the platform
# endpoints (ingest, forecast, invoices, expenses, assistant, overview).
# Held by trusted callers only: the workflow engine (via a secret reference)
# and the dashboard BFF. Never in browser code.
DEMO_API_TOKEN=<generate-a-random-32-byte-secret>

# Browser sign-in credential for the analyst dashboard. Distinct from
# DEMO_API_TOKEN on purpose: a leaked dashboard token must not allow ingestion.
DASHBOARD_TOKEN=<generate-a-different-random-secret>

# Provider API key for Qwen. Only needed when QWEN_MODE=live. The key is bound
# to the region of the base URL; a key from another region returns 401
# invalid_api_key. Reference: https://www.alibabacloud.com/help/en/model-studio/get-api-key
DASHSCOPE_API_KEY=<provider-key-or-leave-placeholder-for-mock-mode>

# ---------------------------------------------------------------------------
# NON-SECRET SETTINGS
# ---------------------------------------------------------------------------

# mock  -> labeled synthetic fixtures, zero provider cost (default, demo-safe)
# live  -> real paid Qwen calls over the OpenAI-compatible HTTP interface
QWEN_MODE=mock

# Regional OpenAI-compatible base URL. Must end in /compatible-mode/v1 and must
# NOT include /chat/completions (the adapter appends that path). It must be
# https:// and must contain no credentials, query, or fragment.
# Workspace-specific domains, per provider documentation:
#   Singapore: https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#   Virginia:  https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   Beijing:   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Confirm your tenant's region and workspace ID; do not copy one blindly.
QWEN_BASE_URL=

# A model ID ENABLED FOR YOUR ACCOUNT in that region, and one that supports the
# OpenAI-compatible HTTP protocol. Note that EnterPro's internal model identifier
# (for example an `alibaba/...` style ID used to configure an agent) is NOT
# automatically valid here: this value goes to the external provider and must
# come from the provider's own catalog. Verify entitlement before the demo.
QWEN_MODEL=

# Scoring API location, as seen by the dashboard BFF.
# Local processes:  http://127.0.0.1:8000
# Compose network:  http://api:8000  (requires FRAUD_API_ALLOW_PRIVATE_HTTP=1)
# Production:       https://fraud-api.internal.example  (no opt-in flag needed)
FRAUD_API_BASE_URL=http://127.0.0.1:8000

# Opt in to plaintext HTTP for a private (non-loopback) backend hostname.
# Leave at 0 unless you are on a trusted private network such as compose.
FRAUD_API_ALLOW_PRIVATE_HTTP=0

# Set to 1 when the dashboard is served over HTTPS so the session cookie is
# marked Secure. Keep 0 for plain http://127.0.0.1 local demos.
DASHBOARD_SECURE_COOKIES=0

# SQLite location. Only used by the API service; must be a writable, durable
# path (a mounted volume in containers). On ephemeral-disk hosts (Render free,
# Cloud Run, Vercel) this resets on restart: acceptable for a demo, not for
# production.
DEMO_DB_PATH=fraud_demo.sqlite3
